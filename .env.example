# MongoDB connection string used by the serverless API in api/*.
# Get this from MongoDB Atlas: Database > Connect > Drivers.
# In Vercel, set this as a Project > Settings > Environment Variables entry
# named MONGODB_URI (for Production, Preview, and Development) with your
# real connection string as the value.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cert-dump?retryWrites=true&w=majority

# Set to "true" to bundle and enable Eruda (a mobile-friendly on-page devtools
# overlay) in the built app — useful for debugging on a phone where you can't
# attach browser devtools. Read at BUILD time (it's a Vite client env var), so
# it must be set wherever the app is built, e.g. Vercel's Environment
# Variables, not just at runtime. Leave unset/"false" for normal deploys.
VITE_ENABLE_DEVTOOLS=false
